# Vest .env example — only these keys are loaded from .env files (DOTENV_ALLOWLIST).
# Existing environment values are never overwritten. This file is plaintext — protect it.

VEST_HOME=
VEST_DB_PATH=
VEST_CONFIG=
RUST_LOG=

# Provider keys (prefer `export ...=...` over CLI flags)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Ollama (local)
OLLAMA_HOST=
OLLAMA_API_KEY=
